{
  "name": "pos-printer-bridge",
  "version": "1.0.0",
  "description": "Electron bridge for cloud POS thermal printing",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "dev": "tsc && electron .",
    "package": "electron-builder --config electron-builder.config.js",
    "package:win": "electron-builder --win --config electron-builder.config.js",
    "package:mac": "electron-builder --mac --config electron-builder.config.js",
    "package:linux": "electron-builder --linux --config electron-builder.config.js"
  },
  "keywords": [
    "pos",
    "printer",
    "electron",
    "bridge"
  ],
  "author": "Benzene POS Solutions",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.2.8",
    "canvas": "^3.2.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "jsbarcode": "^3.12.3"
  }
}
